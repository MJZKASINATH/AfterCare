# Copy this file to .env and replace the placeholder values.
# Keep secrets out of version control.

# App
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Auth0 configuration for the provided tenant
AUTH0_DOMAIN=dev-oclqslhfq460etx8.us.auth0.com
AUTH0_CLIENT_ID=LKQ3L8L7fGl7h4Gavtz4uaPnd6Hoi8lj
AUTH0_CLIENT_SECRET=replace-with-your-auth0-client-secret
AUTH0_SECRET=replace-with-a-64-character-random-string
OAUTH_SCOPE=openid profile email

# Optional compatibility variables for existing project conventions
OAUTH_CLIENT_ID=LKQ3L8L7fGl7h4Gavtz4uaPnd6Hoi8lj
OAUTH_CLIENT_SECRET=replace-with-your-auth0-client-secret
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
OAUTH_AUTHORIZATION_URL=https://dev-oclqslhfq460etx8.us.auth0.com/authorize
OAUTH_TOKEN_URL=https://dev-oclqslhfq460etx8.us.auth0.com/oauth/token
OAUTH_USERINFO_URL=https://dev-oclqslhfq460etx8.us.auth0.com/userinfo
OAUTH_STATE_SECRET=replace-with-a-long-random-string

# JWT / session signing
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
